{
  "expo": {
    "name": "Kairos",
    "slug": "kairos-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a0e30"
    },
    "ios": {
      "supportsTablet": true,
      "buildNumber": "1",
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "bundleIdentifier": "com.jeremypro.kairosmobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/adaptive-icon-background.png",
        "backgroundColor": "#1a0e30"
      },
      "package": "com.jeremypro.kairosmobile",
      "versionCode": 1,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json"
    },
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#f2f2f7"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "kairos-mobile",
    "plugins": [
      "expo-router",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#2563EB"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kairos accède à ta galerie pour joindre des photos aux événements et aux listes de courses.",
          "cameraPermission": "Kairos accède à ton appareil photo pour joindre des photos."
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ad4c8d9b-3498-474a-9173-066087734c73"
      }
    },
    "privacy": "https://moncerveau.vercel.app/privacy",
    "owner": "jeremy-pro"
  }
}
